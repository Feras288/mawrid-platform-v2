# Copy to .env (dev). Never commit real secrets.
APP_ENV=development
APP_URL=http://localhost:3100
BRAND_NAME_AR=مَوْرِد
BRAND_NAME_EN=Mawrid

# Runtime connection uses the non-owner role (RLS enforced). Owner URL is for migrations only.
DATABASE_URL=postgres://app_user:app_dev_password@localhost:5442/platform
DATABASE_OWNER_URL=postgres://platform_owner:owner_dev_password@localhost:5442/platform
APP_DB_PASSWORD=app_dev_password
TEST_DATABASE_URL=postgres://app_user:app_dev_password@localhost:5442/platform_test
TEST_DATABASE_OWNER_URL=postgres://platform_owner:owner_dev_password@localhost:5442/platform_test
REDIS_URL=redis://localhost:6390

# 32+ chars each. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-auth-secret-change-me-0123456789abcdef
APP_ENCRYPTION_KEY=dev-encryption-key-change-me-0123456789abcdef

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=platform-private
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey123
S3_FORCE_PATH_STYLE=true

# Email: leave SMTP_HOST empty to disable real sending safely. Dev uses Mailpit (UI http://localhost:8026).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Platform <no-reply@platform.local>"
SMTP_SECURE=false

# AI: none | anthropic | openai_compatible
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL_EXTRACTION=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Payments: none | test (non-production only) | moyasar
PAYMENT_PROVIDER=test
TEST_PAYMENT_WEBHOOK_SECRET=dev-test-webhook-secret
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

LOG_LEVEL=info
SENTRY_DSN=
